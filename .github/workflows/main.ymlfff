cd "C:\Users\Owner\Documents\Default Project\spatial-inversion-addon"

git init
git branch -M main
git add .
git commit -m "Spatial Inversion add-on"

gh auth login
gh repo create spatial-inversion-addon --public --source=. --remote=origin --push

# Trigger a run manually (the push above already starts one automatically)
gh workflow run "Build" --ref main

# Check the run
gh run list --workflow "Build" --limit 5
